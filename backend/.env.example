# MongoDB Cloud Atlas Connection URI
# Replace <username>, <password>, and cluster address with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/urban_ai?retryWrites=true&w=majority

# Local MongoDB URI (used only if migrating local data to Atlas using npm run migrate)
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/urban_ai

# Server Port
PORT=5000

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here
